{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "side-cart/cart-trigger",
	"title": "Cart Trigger",
	"category": "widgets",
	"description": "A button that opens the side cart drawer.",
	"keywords": ["cart", "woocommerce", "trigger", "button"],
	"version": "1.0.0",
	"textdomain": "side-cart",
	"supports": {
		"html": false,
		"align": false
	},
	"attributes": {
		"className": {
			"type": "string",
			"default": ""
		},
		"triggerText": {
			"type": "string",
			"default": "Cart"
		},
		"icon": {
			"type": "string",
			"default": "bag",
			"enum": ["bag", "handbag", "cart", "basket"]
		},
		"showBadge": {
			"type": "boolean",
			"default": true
		},
		"triggerBg": {
			"type": "string",
			"default": "#111111"
		},
		"triggerColor": {
			"type": "string",
			"default": "#ffffff"
		},
		"triggerFontSize": {
			"type": "integer",
			"default": 14
		},
		"triggerIconSize": {
			"type": "integer",
			"default": 20
		},
		"triggerRadius": {
			"type": "integer",
			"default": 4
		},
		"triggerBadgeBg": {
			"type": "string",
			"default": "#ef4444"
		},
		"triggerBadgeColor": {
			"type": "string",
			"default": "#ffffff"
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css"
}
